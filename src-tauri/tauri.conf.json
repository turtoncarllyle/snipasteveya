{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnipasteVeya",
  "version": "0.1.2",
  "identifier": "com.turtoncarllyle.snipasteveya",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "beforeBundleCommand": "npm run prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SnipasteVeya · 设置 / Settings",
        "width": 520,
        "height": 600,
        "minWidth": 440,
        "minHeight": 480,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f8f9fb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "resources/ocr/": "resources/ocr/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "WebView2/Microsoft.WebView2.FixedVersionRuntime.154.0.4258.37.x64"
      }
    }
  }
}
